{
	"apiVersion": 2,
	"name": "leaf/myblocks",
	"title": "My Blocks",
	"description": "Gunteberg Block",
	"category": "text",
	"icon": "admin-customizer",
	"textdomain": "myblocks",
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-index.css",
	"editorStyle": "file:./build/index.css",
	"attributes": {
		"text": {
			"type": "string",
			"source": "html",
			"selector": "h1"
		}
	},
	"align": {
		"type": "string",
		"default": "left"
	},
	"columns": {
		"type": "number",
		"default": 4
	}
}
